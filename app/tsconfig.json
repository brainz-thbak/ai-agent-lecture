{
  "compilerOptions": {
    "target": "es2023",
    "module": "NodeNext",
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "server",
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["server"]
}
